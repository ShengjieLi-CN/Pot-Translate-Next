{
    "build": {
        "beforeBuildCommand": "node node_modules/vite/bin/vite.js build"
    },
    "package": {
        "productName": "Pot Translate Next"
    },
    "tauri": {
        "bundle": {
            "identifier": "com.shengjieli.pot-translate-next",
            "targets": [
                "msi"
            ],
            "windows": {
                "wix": {
                    "language": [
                        "zh-CN"
                    ]
                }
            }
        },
        "updater": {
            "active": false,
            "dialog": false,
            "endpoints": [],
            "pubkey": ""
        }
    }
}
